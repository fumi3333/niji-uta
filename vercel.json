{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "niji-uta.vercel.app"
        }
      ],
      "destination": "https://nijiuta.fumiproject.dev/$1",
      "permanent": true
    },
    {
      "source": "/setlist",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/setlist/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/archive",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/archive/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/summary",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/summary/",
      "destination": "/",
      "permanent": true
    }
  ]
}