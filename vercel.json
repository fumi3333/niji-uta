{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "niji-uta.vercel.app"
        }
      ],
      "destination": "https://nijiuta.fumiproject.dev/$1",
      "permanent": true
    },
    {
      "source": "/setlist",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/setlist/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/archive",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/archive/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/summary",
      "destination": "/utattemita/",
      "permanent": true
    },
    {
      "source": "/summary/",
      "destination": "/utattemita/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-vercel-skip-toolbar",
          "value": "1"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}